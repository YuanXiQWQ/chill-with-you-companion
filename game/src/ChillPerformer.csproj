<Project Sdk="Microsoft.NET.Sdk">

  <!--
    游戏端 BepInEx 插件。它不依赖本仓库的任何东西，只依赖：
      · .NET Framework 4.7.2 目标包（NuGet 提供）
      · 游戏自带的 UnityEngine.*.dll
      · 游戏目录里的 BepInEx 5.x（BepInEx.dll）

    构建：
      set CHILL_GAME_DIR=<游戏根目录>
      dotnet build -c Release
    产物：src\bin\ChillPerformer.dll → 复制到 <游戏>\BepInEx\plugins\

    找不到游戏目录时构建会失败在 Reference 解析上，这是预期行为。
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ChillPerformer</AssemblyName>
    <RootNamespace>ChillPerformer</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <!-- 游戏目录：环境变量优先，其次常见 Steam 路径。别写死成自己的盘符。 -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">$(CHILL_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Chill With You Lo-Fi Story</GameDir>
    <ManagedDir>$(GameDir)\Chill With You_Data\Managed</ManagedDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(ManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 只往 BepInEx\plugins 复制自己，不碰游戏任何原文件 -->
  <Target Name="DeployToPlugins" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins" />
    <Message Importance="high" Text="ChillPerformer.dll -> $(GameDir)\BepInEx\plugins" />
  </Target>

</Project>
